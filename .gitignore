# Model binaries are downloaded at build time, never committed (E1.8)
models_pack/src/main/assets/models/*.tflite
models_pack/src/main/assets/models/*.bin

# Python tool environments
/tools/**/.venv

# Build output
build/
.gradle/
.kotlin/
*.aab
*.apk

# IDE (shared code style is kept)
.idea/*
!.idea/codeStyles/

# Claude Code local settings
.claude/settings.local.json
